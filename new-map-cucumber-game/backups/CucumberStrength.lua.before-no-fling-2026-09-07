--[[
	CucumberStrength  (ModuleScript, ReplicatedStorage.Modules)
	Shared rules for "how strong do you have to be to pick this cucumber up" plus the
	timeline of the collect choreography. The strength numbers are PLACEHOLDERS
	(user, 2026-09-06: "just make up something random, don't worry about the economy").
	The requirement is HIDDEN (user, 2026-09-06): nothing on screen shows the number,
	you find out by trying.

	  Required(holder)             strength a field cucumber asks for (reads the
	                               StrengthRequired attribute CucumberCarry stamps, else
	                               computes it from Zone / TypeName / Golden / Sliced / Tree)
	  Evaluate(strength, required) -> "easy" | "struggle" | "weak" | "fail", struggleSeconds
	      easy     strength >= EASY_RATIO x required     clean pick-up, steady carry
	      struggle required <= strength < EASY_RATIO x   tug for STRUGGLE_MAX..MIN seconds,
	               then a HEAVY carry: slowed to HEAVY_SPEED_MULT and, FallDelay(ratio)
	               seconds later, a stumble drops the load in front of you -- pick it up
	               again, carry, stumble again ("carry it a little bit but keep falling")
	      weak     below the requirement (WEAK_CAN_LIFT)  tug for WEAK_STRUGGLE seconds, lift
	               it anyway, then it slips WeakHold(ratio) seconds after you stand up: the
	               same stumble, every time (user 2026-09-07: "you can pick up any cucumber
	               but without the strength you pretty much just fall right after pulling and
	               picking it up"). How far you get scales with strength / required (user,
	               later: "depending on how much strength the user has compared to how much
	               is needed, let them walk a couple of steps before falling"): hopeless
	               (ratio ~0) = WEAK_HOLD_MIN, it slips as you stand up; just under the
	               requirement = WEAK_HOLD_MAX, a couple of seconds of (slowed) walking.
	               The lobby never settles a weak carry.
	      fail     below the requirement (WEAK_CAN_LIFT = false): one short tug, then refused
	  Ratio(strength, required)    strength / required (math.huge when nothing is required)
	  FallDelay(ratio, rng?)       seconds of heavy carrying before the next stumble
	  WeakHold(ratio)              seconds a weak lift stays up after the pick-up (no jitter)
	  WeakFallDelay(ratio, rng?)   seconds after the grab before a weak lift slips
	  Format(n)                    short number ("40", "2.5K", "1M") for debugging / toasts

	Timeline (seconds) shared by CucumberCarry (server) and CollectAnimClient:
	  APPROACH        the client walks up to the cucumber
	  + struggle      CucumberStruggle loop (rounded to STRUGGLE_STEP; halved 2026-09-07,
	                  user: "takes too long to pull cucumbers that are too strong")
	  + GRAB_T        into CucumberPickUp: the server swaps the field cucumber for
	                  the shoulder copy (the hands have lifted it to the chest)
	  + rest of PICKUP_LENGTH: the player stands up, then is free again
	  Stumble (user 2026-09-07: "the PLAYER gets flung a couple of studs, towards an earlier
	  biome, then the fall animation"): first the FLING -- a FlingFor(ratio) parabola:
	  FLING_DISTANCE_MIN..MAX studs over FLING_TIME_MIN..MAX seconds, the further under
	  the requirement the further you fly (user, later: "fling player 20+ studs depending
	  on cucumber strength requirement") -- toward the previous biome (CucumberCarry picks
	  the direction and the numbers, CollectAnimClient drives it with a LinearVelocity on
	  the owning client; a plain velocity write is eaten by the Humanoid's ground
	  controller) -- then, on touchdown, the CucumberFall clip (FALL_LENGTH), so every
	  clip time below is offset by the flight time. FALL_DROP_T into the clip the load
	  leaves the shoulder and tumbles back
	  to the slip spot (FALL_LAND_AHEAD studs ahead of where the player stood) over
	  FALL_FLIGHT seconds, where the server re-spawns it as a field cucumber -- inside ANY
	  biome. Outside the biomes (the lobby, off the map) it flies home to its own field
	  instead. Same rule for the DROP button (user 2026-09-07).
]]
local M = {}

--..Requirements (placeholders)..--
M.ZONE_BASE = {
	Spawn = 0, Desert = 10, Samurai = 30, Farm = 100, Snow = 300,
	Underwater = 1000, Volcano = 3000, Narmek = 10000, Toyland = 30000, Neon = 100000,
}
M.TYPE_FACTORS = {0.6, 0.8, 1, 1.25, 1.5} -- one per TypeName, picked by a stable hash
M.SLICED_FACTOR = 0.5 -- slices are light
M.TREE_FACTOR = 3 -- landmark trees are heavy
M.GOLDEN_FACTOR = 2
M.GOLDEN_MIN = 6 -- a golden cucumber always asks for a few bench reps, even in Spawn
M.TREE_MIN = 12

--..Bands..--
M.EASY_RATIO = 1.5 -- this much spare strength: clean pick-up, full speed, no stumble
M.FLOOR_RATIO = 1.0 -- below the requirement itself: a WEAK lift (slips right away) or, with WEAK_CAN_LIFT off, no budge
M.STRUGGLE_MIN = 0.5 -- seconds of tugging just under EASY_RATIO (halved 2026-09-07, user: "takes too long")
M.STRUGGLE_MAX = 2.5 -- seconds at exactly the requirement
M.STRUGGLE_STEP = 0.5 -- struggle times round to this (half loops of the 1 s clip)

--..Weak lift (below the requirement)..--
M.WEAK_CAN_LIFT = true -- false = the old rule: one short tug, then "Too heavy!"
M.WEAK_STRUGGLE = 2.5 -- seconds of tugging before a weak lift (= STRUGGLE_MAX; halved 2026-09-07)
M.WEAK_HOLD_MIN = 0.2 -- seconds up after the pick-up clip at ratio 0 (hopeless: it slips as you stand)
M.WEAK_HOLD_MAX = 2.0 -- seconds up just under the requirement (a couple of steps at HEAVY_SPEED_MULT)
M.WEAK_HOLD_CURVE = 1.5 -- hold = MIN + (MAX - MIN) * ratio ^ CURVE: half the requirement gives ~0.85 s, 90 % ~1.75 s
M.WEAK_RETRY = 0.5 -- seconds before another try when the slip could not happen right now

--..Stumble fling (the player, toward the previous biome, before the fall clip; user
--..2026-09-07: "fling player 20+ studs depending on cucumber strength requirement")..--
M.FLING_DISTANCE_MIN = 5 -- studs at the requirement (and for every heavy-band stumble)
M.FLING_DISTANCE_MAX = 30 -- studs for a hopeless lift (ratio 0)
M.FLING_CURVE = 0.7 -- distance = MIN + (MAX - MIN) * (1 - ratio) ^ CURVE: half the requirement flings ~20 studs, 90 % ~10
M.FLING_TIME_MIN = 0.25 -- seconds in the air for the shortest fling (the hop peaks at g * T^2 / 8: about 1.5 studs)
M.FLING_TIME_MAX = 0.6 -- for the longest (peak about 9 studs)

--..Heavy carry (struggle band)..--
M.HEAVY_SPEED_MULT = 0.6 -- WalkSpeed while lugging something near your limit
M.FALL_DELAY_MIN = 3 -- seconds of carrying before the stumble, at exactly the requirement
M.FALL_DELAY_MAX = 7 -- just under EASY_RATIO
M.FALL_JITTER = 0.25 -- +-25 % so it never feels like a timer
M.FALL_RETRY = 2 -- seconds before another try when a stumble could not happen (busy, seated, fields closed)

--..Timeline..--
M.APPROACH = 0.6
M.PICKUP_LENGTH = 1.4
M.GRAB_T = 1.0
M.STRUGGLE_LOOP = 1.0
M.FAIL_TUG = 1.0
M.FALL_LENGTH = 2.4 -- CucumberFall clip
M.FALL_DROP_T = 0.467 -- into the clip: the load leaves the shoulder
M.FALL_FLIGHT = 0.5 -- seconds it tumbles to the ground
M.FALL_LAND_AHEAD = 1.5 -- studs ahead of where the player stood when it slipped (the player is flung the other way)

local function hash(s)
	local h = 5381
	for i = 1, #s do
		h = (h * 33 + s:byte(i)) % 4294967296
	end
	return h
end

--.. two significant digits: 37.5 -> 38, 1875 -> 1900
local function nice(n)
	if n <= 0 then return 0 end
	local mag = 10 ^ (math.floor(math.log10(n)) - 1)
	return math.floor(n / mag + 0.5) * mag
end

function M.IsTree(typeName)
	local s = string.lower(tostring(typeName or ""))
	return s:find("tree", 1, true) ~= nil or s:find("grove", 1, true) ~= nil or s:find("palm", 1, true) ~= nil
end

function M.Compute(zone, typeName, golden, sliced, tree)
	local base = M.ZONE_BASE[zone] or 0
	local factor = M.TYPE_FACTORS[hash(tostring(typeName)) % #M.TYPE_FACTORS + 1]
	if sliced then factor = M.SLICED_FACTOR end
	if tree then factor = M.TREE_FACTOR end
	local required = base * factor
	if golden then required = math.max(required * M.GOLDEN_FACTOR, M.GOLDEN_MIN) end
	if tree then required = math.max(required, M.TREE_MIN) end
	return nice(required)
end

function M.Required(holder)
	local stamped = holder:GetAttribute("StrengthRequired")
	if type(stamped) == "number" then return stamped end
	local typeName = holder:GetAttribute("TypeName") or holder.Name
	local tree = holder:GetAttribute("Tree") == true or M.IsTree(typeName)
	return M.Compute(holder:GetAttribute("Zone") or "Spawn", typeName, holder:GetAttribute("Golden") == true, holder:GetAttribute("Sliced") == true, tree)
end

function M.Ratio(strength, required)
	strength = tonumber(strength) or 0
	required = tonumber(required) or 0
	if required <= 0 then return math.huge end
	return strength / required
end

function M.Evaluate(strength, required)
	local ratio = M.Ratio(strength, required)
	if ratio >= M.EASY_RATIO then return "easy", 0 end
	if ratio < M.FLOOR_RATIO then
		if M.WEAK_CAN_LIFT then return "weak", M.WEAK_STRUGGLE end
		return "fail", 0
	end
	--.. 0 at the requirement, 1 at the easy band
	local a = (ratio - M.FLOOR_RATIO) / (M.EASY_RATIO - M.FLOOR_RATIO)
	local seconds = M.STRUGGLE_MAX + (M.STRUGGLE_MIN - M.STRUGGLE_MAX) * a
	--.. half loops of the struggle clip
	seconds = math.max(M.STRUGGLE_STEP, math.floor(seconds / M.STRUGGLE_STEP + 0.5) * M.STRUGGLE_STEP)
	return "struggle", seconds
end

--.. seconds of heavy carrying before the stumble: FALL_DELAY_MIN at the requirement,
--.. FALL_DELAY_MAX just under EASY_RATIO, +-FALL_JITTER
function M.FallDelay(ratio, rng)
	local a = math.clamp(((tonumber(ratio) or M.FLOOR_RATIO) - M.FLOOR_RATIO) / (M.EASY_RATIO - M.FLOOR_RATIO), 0, 1)
	local base = M.FALL_DELAY_MIN + (M.FALL_DELAY_MAX - M.FALL_DELAY_MIN) * a
	local r = rng and rng:NextNumber(-1, 1) or (math.random() * 2 - 1)
	return base * (1 + M.FALL_JITTER * r)
end

--.. fling distance (studs) and flight time (seconds) for a stumble: the further under the
--.. requirement, the further (and longer) you fly; heavy-band stumbles (ratio >= 1) and a
--.. missing ratio use the minimum
function M.FlingFor(ratio)
	local r = math.clamp((tonumber(ratio) or 1) / M.FLOOR_RATIO, 0, 1)
	local a = (1 - r) ^ M.FLING_CURVE
	local distance = M.FLING_DISTANCE_MIN + (M.FLING_DISTANCE_MAX - M.FLING_DISTANCE_MIN) * a
	local span = M.FLING_DISTANCE_MAX - M.FLING_DISTANCE_MIN
	local b = span > 0 and (distance - M.FLING_DISTANCE_MIN) / span or 0
	local time = M.FLING_TIME_MIN + (M.FLING_TIME_MAX - M.FLING_TIME_MIN) * b
	return distance, time
end

--.. seconds a weak lift stays on the shoulder after the pick-up clip: WEAK_HOLD_MIN at
--.. ratio 0, WEAK_HOLD_MAX just under the requirement, bowed by WEAK_HOLD_CURVE so a
--.. hopeless lift slips at once and only near-misses get to walk
function M.WeakHold(ratio)
	local a = math.clamp((tonumber(ratio) or 0) / M.FLOOR_RATIO, 0, 1)
	return M.WEAK_HOLD_MIN + (M.WEAK_HOLD_MAX - M.WEAK_HOLD_MIN) * a ^ M.WEAK_HOLD_CURVE
end

--.. seconds after the GRAB (where the server starts the stumble timer) before a weak
--.. lift slips: the rest of the pick-up clip, then WeakHold(ratio) +-FALL_JITTER
function M.WeakFallDelay(ratio, rng)
	local r = rng and rng:NextNumber(-1, 1) or (math.random() * 2 - 1)
	return (M.PICKUP_LENGTH - M.GRAB_T) + M.WeakHold(ratio) * (1 + M.FALL_JITTER * r)
end

function M.Format(n)
	n = tonumber(n) or 0
	if n >= 1e9 then return string.format("%.3gB", n / 1e9) end
	if n >= 1e6 then return string.format("%.3gM", n / 1e6) end
	if n >= 1e3 then return string.format("%.3gK", n / 1e3) end
	return tostring(math.floor(n + 0.5))
end

return M
