local function setLabels()
	local name = player:GetAttribute("CarryingCucumber")
	nameLabel.Text = name and CucumberMutations.ColorizeName(string.upper(name)) or ""
end

local punchTween
local function punch()
	if punchTween then punchTween:Cancel() end
	punchScale.Scale = 1
	punchTween = TweenService:Create(punchScale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1.18})
	punchTween.Completed:Once(function(s)
		if s ~= Enum.PlaybackState.Completed then return end
		punchTween = TweenService:Create(punchScale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
		punchTween:Play()
	end)
	punchTween:Play()
end

--.. keep the billboard latched to the CURRENT shoulder model (it replicates a
--.. beat after the attribute, and a same-name swap makes no attribute edge)
local latchedPart
task.spawn(function()
	while true do
		if player:GetAttribute("CarryingCucumber") ~= nil then
			local char = player.Character
			local model = char and char:FindFirstChild("CarriedCucumber")
			local part = model and (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
			if part and part:IsDescendantOf(workspace) then
				local anchor = billboard.Adornee
				if latchedPart ~= part or not (anchor and anchor.Parent == part) then
					if anchor and anchor:IsA("Attachment") then anchor:Destroy() end
					anchor = Instance.new("Attachment")
					anchor.Name = "CarryBillboardAnchor"
					anchor.Parent = part
					billboard.Adornee = anchor
					latchedPart = part
					setLabels()
				end
				local ok, bboxCF, bboxSize = pcall(model.GetBoundingBox, model)
				if ok then
					--.. the billboard is centred on the anchor: keep its bottom edge 0.4 studs over the model
						anchor.WorldPosition = bboxCF.Position + Vector3.new(0, bboxSize.Y * 0.5 + CARRY_H * 0.5 + 0.4, 0)
				end
				billboard.Enabled = true
			else
				billboard.Enabled = false
			end
		else
			billboard.Enabled = false
			billboard.Adornee = nil
			latchedPart = nil
		end
		task.wait(0.25)
	end
end)

player:GetAttributeChangedSignal("CarryingCucumber"):Connect(function()
	setLabels()
	if player:GetAttribute("CarryingCucumber") ~= nil then punch() end
end)
setLabels()

button.Activated:Connect(function()
	DropRemote:FireServer()
end)

