tp.PaddingRight = UDim.new(0, 12)
tp.Parent = toast

local token = 0
local function Toast(text, color)
	token += 1
	local my = token
	toast.Text = text
	toast.TextColor3 = color or Color3.fromRGB(255, 255, 255)
	toast.TextTransparency = 0
	toast.BackgroundTransparency = 0.25
	toast.Visible = true
	task.delay(2.2, function()
		if my ~= token then return end
		TweenService:Create(toast, TweenInfo.new(0.4), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
		task.delay(0.45, function()
			if my == token then toast.Visible = false end
		end)
	end)
end

--..FX..--
local function dirtPuffRing(position)
	local part = Instance.new("Part")
	part.Name = "ReplantDirtPuff"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(3, 0.4, 3)
	part.CFrame = CFrame.new(position + Vector3.new(0, 0.4, 0))
	part.Parent = workspace
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(Color3.fromRGB(150, 112, 70), Color3.fromRGB(95, 72, 48))
	e.Lifetime = NumberRange.new(0.35, 0.6)
	e.Speed = NumberRange.new(6, 11)
	e.SpreadAngle = Vector2.new(85, 85)
	e.Acceleration = Vector3.new(0, -22, 0)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-120, 120)
	e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 0.1)})
	e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1)})
	e.Enabled = false
	e.Parent = part
	e:Emit(14)
	Debris:AddItem(part, 1.2)
end

--.. green comet launching off the shoulder in a high arc toward the home field
local function flyHomeComet(targetPos)
	local char = player.Character
	local shoulder = char and (char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart"))
	if not shoulder then return end
	local from = shoulder.Position + Vector3.new(0, 1, 0)
	local dir = Vector3.zAxis
	if typeof(targetPos) == "Vector3" then
		local flat = Vector3.new(targetPos.X - from.X, 0, targetPos.Z - from.Z)
		if flat.Magnitude > 0.01 then dir = flat.Unit end
	end
	local comet = Instance.new("Part")
	comet.Name = "CarryHomeComet"
	comet.Shape = Enum.PartType.Ball
	comet.Size = Vector3.new(0.6, 0.6, 0.6)
	comet.Material = Enum.Material.Neon
	comet.Color = Color3.fromRGB(120, 255, 120)
	comet.Anchored = true
	comet.CanCollide = false
	comet.CanQuery = false
	comet.CanTouch = false
	comet.CastShadow = false
	comet.CFrame = CFrame.new(from)
	local a0 = Instance.new("Attachment") a0.Position = Vector3.new(0, 0.15, 0) a0.Parent = comet
	local a1 = Instance.new("Attachment") a1.Position = Vector3.new(0, -0.15, 0) a1.Parent = comet
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(Color3.fromRGB(150, 255, 150))
	trail.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1)})
	trail.Lifetime = 0.25
	trail.LightEmission = 0.7
	trail.WidthScale = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2)})
	trail.Parent = comet
	comet.Parent = workspace
	Debris:AddItem(comet, 1.2)
	task.spawn(function()
		local DUR = 1.1
		local t0 = os.clock()
		while comet.Parent do
			local a = (os.clock() - t0) / DUR
			if a >= 1 then break end
			local height = math.sin(a * math.pi) * 24
			comet.CFrame = CFrame.new(from + dir * (a * 55) + Vector3.new(0, height, 0))
			comet.Transparency = math.max(0, (a - 0.45) / 0.55)
			RunService.Heartbeat:Wait()
		end
		if comet.Parent then comet:Destroy() end
	end)
end

FXRemote.OnClientEvent:Connect(function(payload)
	if type(payload) ~= "table" then return end
	local kind = payload.Kind
	if kind == "Pickup" then
		SoundController.PlayFX("Collect", {Volume = 0.6, Pitch = 0.05}) -- no "Collected a ..." toast (user, 2026-09-06)
	elseif kind == "Replant" then
		if typeof(payload.Position) == "Vector3" then
			SoundController.PlayFXAt("Dirt Dig", payload.Position, {MaxLife = 0.9})
			dirtPuffRing(payload.Position)
		end
	elseif kind == "FlyHome" then
		SoundController.PlayFX("Slide Whistle", {Volume = 0.5})
		flyHomeComet(payload.Position)
		Toast(("Sent the %s back to %s!"):format(tostring(payload.Name or "cucumber"), tostring(payload.Zone or "its field")), Color3.fromRGB(150, 255, 150))
	elseif kind == "Placed" then
		SoundController.PlayFX("Success", {Volume = 0.6})
		Toast(("Placed the %s on your plot!"):format(tostring(payload.Name or "cucumber")), Color3.fromRGB(150, 255, 150))
	elseif kind == "Refused" then
		SoundController.PlayFX("Error", {Volume = 0.5})
		Toast(tostring(payload.Reason or "Can't do that right now."), Color3.fromRGB(255, 120, 120))
	end
end)

