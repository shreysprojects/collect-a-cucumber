--[[
	CarryClient  (LocalScript, StarterPlayerScripts)
	While the server marks us as carrying a cucumber (CarryingCucumber player
	attribute, set by CucumberCarry), a STUD-sized BillboardGui (scale units like the
	plot owner badge in PlotBadges, so it shrinks with distance) rides the
	CarriedCucumber model on our shoulder: cucumber name, a DROP button
	(Remotes.DropCucumber) and a "take it to your plot" hint. Also plays the
	Remotes.CarryFX cues (pickup / replant / fly home / placed = sound only / refused toast;
	toasts use the game-wide ReplicatedStorage.Modules.Notify style, user 2026-09-07).
	Hints (2026-09-07): one per CucumberStrength band via CarryingCucumberBand while
	CarryingCucumberHeavy is set (sturdy = "watch your step", shaky = "hurry", hopeless =
	"it's slipping"); the Stumble cue carries Weak (hopeless) for its toast.
	Compact port of the Zombie Cucumber Game's CarryClient (no authored GUI here,
	everything is built in code).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")

local SoundController = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("SoundController"))
local CucumberMutations = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CucumberMutations"))
local CucumberStrength = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CucumberStrength"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local DropRemote = Remotes:WaitForChild("DropCucumber")
local FXRemote = Remotes:WaitForChild("CarryFX")

local CARRY_W, CARRY_H = 6, 2.4 -- STUDS (BillboardGui scale units), like PlotBadges: same size in the world at any camera distance
local CARRY_MAX_DISTANCE = 120
local FONT = Enum.Font.FredokaOne

--..Billboard..--
