billboard.Size = UDim2.fromScale(CARRY_W, CARRY_H)
billboard.MaxDistance = CARRY_MAX_DISTANCE
billboard.LightInfluence = 0
billboard.AlwaysOnTop = true
billboard.Active = true -- REQUIRED for descendant GuiButtons to get input in a BillboardGui
billboard.Enabled = false
billboard.Parent = host

local content = Instance.new("Frame")
content.Name = "Cluster"
content.BackgroundTransparency = 1
content.AnchorPoint = Vector2.new(0.5, 0.5)
content.Position = UDim2.fromScale(0.5, 0.5)
content.Size = UDim2.fromScale(1, 1)
content.Parent = billboard

local punchScale = Instance.new("UIScale")
punchScale.Name = "PunchScale"
punchScale.Parent = content

local function stroke(parent, thickness, color)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness
	s.Color = color or Color3.fromRGB(20, 40, 15)
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Parent = parent
	return s
end

local nameLabel = Instance.new("TextLabel")
nameLabel.Name = "NameLabel"
nameLabel.BackgroundTransparency = 1
nameLabel.AnchorPoint = Vector2.new(0.5, 0)
nameLabel.Position = UDim2.fromScale(0.5, 0)
nameLabel.Size = UDim2.fromScale(1, 0.34)
nameLabel.Font = FONT
nameLabel.TextScaled = true
nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
