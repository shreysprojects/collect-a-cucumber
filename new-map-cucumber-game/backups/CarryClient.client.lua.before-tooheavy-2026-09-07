end

--..FX..--
local function dirtPuffRing(position)
	local part = Instance.new("Part")
	part.Name = "ReplantDirtPuff"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(3, 0.4, 3)
	part.CFrame = CFrame.new(position + Vector3.new(0, 0.4, 0))
	part.Parent = workspace
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(Color3.fromRGB(150, 112, 70), Color3.fromRGB(95, 72, 48))
	e.Lifetime = NumberRange.new(0.35, 0.6)
	e.Speed = NumberRange.new(6, 11)
	e.SpreadAngle = Vector2.new(85, 85)
	e.Acceleration = Vector3.new(0, -22, 0)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-120, 120)
	e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 0.1)})
	e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1)})
	e.Enabled = false
	e.Parent = part
	e:Emit(14)
	Debris:AddItem(part, 1.2)
end

--.. green comet launching off the shoulder in a high arc toward the home field
local function flyHomeComet(targetPos)
	local char = player.Character
	local shoulder = char and (char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart"))
	if not shoulder then return end
	local from = shoulder.Position + Vector3.new(0, 1, 0)
	local dir = Vector3.zAxis
	if typeof(targetPos) == "Vector3" then
		local flat = Vector3.new(targetPos.X - from.X, 0, targetPos.Z - from.Z)
		if flat.Magnitude > 0.01 then dir = flat.Unit end
	end
	local comet = Instance.new("Part")
	comet.Name = "CarryHomeComet"
	comet.Shape = Enum.PartType.Ball
	comet.Size = Vector3.new(0.6, 0.6, 0.6)
	comet.Material = Enum.Material.Neon
	comet.Color = Color3.fromRGB(120, 255, 120)
	comet.Anchored = true
	comet.CanCollide = false
	comet.CanQuery = false
	comet.CanTouch = false
	comet.CastShadow = false
	comet.CFrame = CFrame.new(from)
	local a0 = Instance.new("Attachment") a0.Position = Vector3.new(0, 0.15, 0) a0.Parent = comet
	local a1 = Instance.new("Attachment") a1.Position = Vector3.new(0, -0.15, 0) a1.Parent = comet
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(Color3.fromRGB(150, 255, 150))
	trail.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1)})
	trail.Lifetime = 0.25
	trail.LightEmission = 0.7
	trail.WidthScale = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2)})
	trail.Parent = comet
	comet.Parent = workspace
	Debris:AddItem(comet, 1.2)
	task.spawn(function()
		local DUR = 1.1
		local t0 = os.clock()
		while comet.Parent do
			local a = (os.clock() - t0) / DUR
			if a >= 1 then break end
			local height = math.sin(a * math.pi) * 24
			comet.CFrame = CFrame.new(from + dir * (a * 55) + Vector3.new(0, height, 0))
			comet.Transparency = math.max(0, (a - 0.45) / 0.55)
			RunService.Heartbeat:Wait()
		end
		if comet.Parent then comet:Destroy() end
	end)
end

--.. "made it to the lobby" screen bounce: the camera dips and springs back (damped, ~0.6 s)
--.. with a small roll and a FOV punch. Applied AFTER the camera scripts each frame; if
--.. nothing else rewrote the camera since our last write, our previous offset is removed
--.. first so it never accumulates.
local BOUNCE_NAME = "CarryLobbyBounce"
local function cameraBounce()
	local camera = workspace.CurrentCamera
	if not camera then return end
	pcall(RunService.UnbindFromRenderStep, RunService, BOUNCE_NAME)
	local DUR = 0.65
	local t0 = os.clock()
	local baseFov = camera.FieldOfView
	local lastSet, applied
	RunService:BindToRenderStep(BOUNCE_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		local a = (os.clock() - t0) / DUR
		local cf = camera.CFrame
		if lastSet and applied and cf:FuzzyEq(lastSet, 1e-4) then cf = cf * applied:Inverse() end
		if a >= 1 then
			RunService:UnbindFromRenderStep(BOUNCE_NAME)
			camera.CFrame = cf
			camera.FieldOfView = baseFov
			return
		end
		local decay = math.exp(-4 * a)
		local dip = -math.sin(a * math.pi * 3) * 1.3 * decay -- studs: down first, then springs back
		local roll = math.sin(a * math.pi * 3 + 0.6) * math.rad(1.5) * decay
		applied = CFrame.new(0, dip, 0) * CFrame.Angles(0, 0, roll)
		lastSet = cf * applied
		camera.CFrame = lastSet
		camera.FieldOfView = baseFov + 7 * math.sin(a * math.pi) * decay
	end)
end

FXRemote.OnClientEvent:Connect(function(payload)
	if type(payload) ~= "table" then return end
	local kind = payload.Kind
	if kind == "Pickup" then
		SoundController.PlayFX("Collect", {Volume = 0.6, Pitch = 0.05}) -- no "Collected a ..." toast (user, 2026-09-06)
	elseif kind == "Replant" then
		if typeof(payload.Position) == "Vector3" then
			SoundController.PlayFXAt("Dirt Dig", payload.Position, {MaxLife = 0.9})
			dirtPuffRing(payload.Position)
		end
	elseif kind == "FlyHome" then
		SoundController.PlayFX("Slide Whistle", {Volume = 0.5})
		flyHomeComet(payload.Position)
		Toast(("Sent the %s back to %s!"):format(tostring(payload.Name or "cucumber"), tostring(payload.Zone or "its field")), Notify.COLORS.Success)
	elseif kind == "Placed" then
		SoundController.PlayFX("Success", {Volume = 0.6}) -- no "Placed the ... on your plot!" toast (user, 2026-09-06)
	elseif kind == "Refused" then
		SoundController.PlayFX("Error", {Volume = 0.5})
		Toast(tostring(payload.Reason or "Can't do that right now."), Notify.COLORS.Error)
	elseif kind == "Stumble" then
		--.. it slipped off the shoulder: inside a biome it lands where it slipped, FALL_FLIGHT
		--.. later (CollectAnimClient tumbles it); outside the biomes (Home) it flew back to its field
		local name = tostring(payload.Name or "cucumber")
		if payload.Home then
			SoundController.PlayFX("Slide Whistle", {Volume = 0.5})
			flyHomeComet(payload.Position)
			if payload.Weak then
				Toast(("Too heavy! The %s slipped off and flew back to %s. Hit the bench to get stronger."):format(name, tostring(payload.Zone or "its field")), Notify.COLORS.Error)
			else
				Toast(("Oof! The %s slipped off and flew back to %s."):format(name, tostring(payload.Zone or "its field")), Notify.COLORS.Warn)
			end
		else
			if payload.Weak then
				--.. below the requirement: it went straight down again
				Toast(("Too heavy! The %s slipped right off. Hit the bench to get stronger."):format(name), Notify.COLORS.Error)
			else
				Toast(("Oof! The %s was too heavy to carry far. Pick it up again!"):format(name), Notify.COLORS.Warn)
			end
			if typeof(payload.Position) == "Vector3" then
				task.delay(CucumberStrength.FALL_FLIGHT, dirtPuffRing, payload.Position)
			end
		end
	elseif kind == "LobbyReached" then
		--.. carried it into the lobby: screen bounce + sting; a heavy load is light from here on
		cameraBounce()
		punch()
		SoundController.PlayFX("Big Thud", {Volume = 0.4, MaxLife = 1})
		SoundController.PlayFX("Magic Shimmer", {Volume = 0.55})
		if payload.WasHeavy then
			Toast(("Phew! You made it to the lobby with the %s. It feels lighter already!"):format(tostring(payload.Name or "cucumber")), Notify.COLORS.Success)
		end
	end
end)

